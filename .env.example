# LLM provider
# The installed requirements support OpenAI and Groq.
CHAT_MODEL_PROVIDER=groq
CHAT_MODEL=openai/gpt-oss-120b
CHAT_MODEL_FAST=openai/gpt-oss-20b
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_TEMPERATURE=0.0

# Companies House
COMPANIES_HOUSE_API_KEY=
COMPANIES_HOUSE_BASE_URL=https://api.company-information.service.gov.uk

# FCA Register
FCA_API_KEY=
FCA_API_EMAIL=
FCA_BASE_URL=https://register.fca.org.uk/services/V0.1

# Optional legacy NewsAPI connector
NEWS_API_KEY=
NEWS_API_BASE_URL=https://newsapi.org/v2

# Brave Search
BRAVE_SEARCH_API_KEY=

# OpenSanctions
OPEN_SANCTIONS_API_KEY=
OPEN_SANCTIONS_BASE_URL=https://api.opensanctions.org

# The Gazette needs no key. Set to false only where The Gazette refuses the server (the public demo on
# Hugging Face): it's then declared "not covered" instead of "couldn't check" on every run.
GAZETTE_ENABLED=true

# Research behaviour
USE_MOCK_DATA=true
MAX_FOLLOWUP_ITERATIONS=2
CONFIDENCE_THRESHOLD=0.6

# Browser access to the API, comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agentic_company_research_poc

# Pre-screen
# PRESCREEN_ACCESS_TOKEN=choose-a-code
# PRESCREEN_RUNS_PER_HOUR=30

# Shared demo (src/prescreen/access.py). With PRESCREEN_ACCESS_TOKEN set as the owner code:
# guest demo codes, stored hashed. Make one with: python scripts/guest_code.py <label> --days 30
# PRESCREEN_GUEST_CODES=label:sha256:YYYY-MM-DD,label2:sha256:YYYY-MM-DD
# Saved report ids anyone can read without a code (read-only)
# PRESCREEN_PUBLIC_EXAMPLES=
# PRESCREEN_REQUEST_URL=https://www.ai-toolstack.com/contact/
# Guests run on free models only. A paid provider here is refused, never used.
# GUEST_AGENT_PROVIDER=groq
# GUEST_AGENT_MODEL=openai/gpt-oss-120b
# GUEST_AGENT_JUDGE=on
# GUEST_CHAT_MODEL=openai/gpt-oss-20b
# GUEST_PRESCREENS_PER_DAY=5
# GUEST_AGENT_REVIEWS_PER_DAY=2
# GUEST_TOTAL_PRESCREENS_PER_DAY=40
# GUEST_TOTAL_AGENT_REVIEWS_PER_DAY=10
